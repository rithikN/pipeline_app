/* ==============================
   Base widget style
   ============================== */
QWidget#WorkFilesForm {
    background-color: #010409;
    color: #E1E1E8;
    font-size: 14px;
}


/* ==============================
   List widget
   ============================== */
QListWidget#workFiles_listWidget {
    background-color: #010409;
    border: none;
    color: #E1E1E8;
}

QListWidget#workFiles_listWidget::item {
    background-color: #E1E1E8;
    border-radius: 5px;
    border: none;
}

/* ==============================
   Selected item highlight
   ============================== */
QListWidget#workFiles_listWidget::item:selected {
    border: 0.1px solid #010409;
    border-radius: 5px;
    margin: 1px;
}

/* Remove dotted focus outline when list or item is focused */
QListWidget:focus,
QListWidget::item:focus,
QListWidget::item:selected:focus {
    outline: none;
    border: none;
}




QComboBox#sort_comboBox {
    padding: 0px;
}


/* ==============================
   Context Menu
   ============================== */

QMenu {
    background-color: #8391aa;
    border: 1px solid #111419;
    padding: 2px 1px 2px 1px;
}

QMenu::item {
    background-color: #010409;
    color: #E1E1E8;
    padding: 8px 12px;
    min-width: 160px;
    border-bottom: 1.5px solid #8391aa;
    border-top: 1.5px solid #8391aa;
}

/* ==============================
   Create File Button
   ============================== */

QPushButton#createFileButton {
    font-size: 14px;
    background-color:rgb(58, 110, 158);
    border-radius: 5px;
    border: none;
    color: #E1E1E8;
}

QPushButton#createFileButton:hover {
    background-color: rgb(97, 150, 199);
    color: #010409;
}
